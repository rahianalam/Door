<section class="browse-guides-section">
    <div class="container">
        <div class="section-header">
            <h2 class="section-title"><?php esc_html_e('Browse Guides by Category', 'dooroora'); ?></h2>
        </div>

        <div class="guides-tabs" id="guides-tabs">
            <button class="guides-tab active" data-category="all"><?php esc_html_e('All', 'dooroora'); ?></button>
            <?php
            $categories = get_categories(array('hide_empty' => false));
            $map = dooroora_get_category_mapping();
            foreach ($categories as $category) :
                if (!isset($map[$category->slug])) continue;
            ?>
                <button class="guides-tab" data-category="<?php echo esc_attr($category->slug); ?>"><?php echo esc_html($category->name); ?></button>
            <?php endforeach; ?>
        </div>

        <div class="guides-grid" id="guides-grid" data-layout="grid">
            <?php
            $latest = new WP_Query(array(
                'posts_per_page' => 6,
                'post_status'    => 'publish',
            ));
            while ($latest->have_posts()) : $latest->the_post();
            ?>
                <article id="post-<?php the_ID(); ?>" <?php post_class('guide-card'); ?>>
                    <?php if (has_post_thumbnail()) : ?>
                        <a class="guide-card-thumb" href="<?php the_permalink(); ?>">
                            <?php the_post_thumbnail('blog-grid'); ?>
                        </a>
                    <?php endif; ?>
                    <div class="guide-card-body">
                        <?php if (has_category()) : ?>
                            <div class="guide-card-category"><?php the_category(', '); ?></div>
                        <?php endif; ?>
                        <h3 class="guide-card-title">
                            <a href="<?php the_permalink(); ?>"><?php the_title(); ?></a>
                        </h3>
                        <div class="guide-card-meta">
                            <span class="guide-card-author"><?php echo esc_html(get_the_author()); ?></span>
                            <span class="guide-card-date"><?php echo esc_html(get_the_date()); ?></span>
                            <span class="guide-card-readtime"><?php echo esc_html(dooroora_reading_time()); ?></span>
                        </div>
                        <div class="guide-card-excerpt"><?php echo wp_trim_words(get_the_excerpt(), 30); ?></div>
                        <a class="guide-card-cta" href="<?php the_permalink(); ?>"><?php esc_html_e('Read Guide', 'dooroora'); ?> &rarr;</a>
                    </div>
                </article>
            <?php
            endwhile;
            wp_reset_postdata();
            ?>
        </div>

        <div class="guides-loading" id="guides-loading" style="display:none;">
            <i class="fa-solid fa-spinner fa-spin"></i> <?php esc_html_e('Loading guides...', 'dooroora'); ?>
        </div>
    </div>
</section>
