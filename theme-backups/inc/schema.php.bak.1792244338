<?php
/**
 * JSON-LD Schema generation
 *
 * @package DoorOora
 * @since 1.0.0
 */

defined('ABSPATH') || exit;

add_action('wp_head', 'dooroora_output_schemas', 1);
function dooroora_output_schemas() {
    $schemas = array();
    $schemas[] = dooroora_organization_schema();

    if (is_single()) {
        $schemas[] = dooroora_article_schema();
        $schemas[] = dooroora_breadcrumb_schema();
        $schemas[] = dooroora_author_schema();

        $faqs = dooroora_extract_faq_blocks();
        if (!empty($faqs)) {
            $schemas[] = dooroora_faq_schema($faqs);
        }
    }

    if (is_singular() && !is_single()) {
        $schemas[] = dooroora_breadcrumb_schema();
    }

    if (is_page('contact-us') || is_page('contact')) {
        $schemas[] = dooroora_contact_page_schema();
    }

    // Homepage custom schema from admin settings
    if (is_front_page()) {
        $homepage_schema = get_option('dooroora_homepage_schema', '');
        if (!empty($homepage_schema)) {
            // Strip any HTML/script tags in case user pasted markup
            $homepage_schema = wp_kses($homepage_schema, array());
            $schemas[] = $homepage_schema;
        }
    }

    $schemas = array_filter($schemas);
    if (empty($schemas)) return;

    echo '<script type="application/ld+json">' . "\n";
    echo '[' . implode(',' . "\n", $schemas) . ']' . "\n";
    echo '</script>' . "\n";
}

function dooroora_organization_schema() {
    $name  = get_option('dooroora_org_name', get_bloginfo('name'));
    $logo  = get_option('dooroora_org_logo', '');
    if (empty($logo) && get_theme_mod('custom_logo')) {
        $logo = wp_get_attachment_image_url(get_theme_mod('custom_logo'), 'full');
    }

    $social = get_option('dooroora_org_social_profiles', '');
    $sameAs = array();
    if (!empty($social)) {
        $lines = explode("\n", $social);
        foreach ($lines as $line) {
            $url = trim($line);
            if (!empty($url)) $sameAs[] = esc_url($url);
        }
    }

    $org = array(
        '@context' => 'https://schema.org',
        '@type'    => 'Organization',
        'name'     => $name ?: get_bloginfo('name'),
        'url'      => home_url('/'),
        'description' => get_bloginfo('description'),
    );

    if ($logo) $org['logo'] = $logo;
    if (!empty($sameAs)) $org['sameAs'] = $sameAs;

    return wp_json_encode($org, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
}

function dooroora_article_schema() {
    if (!is_singular('post')) return '';

    $post_id = get_the_ID();
    $author_id = get_post_field('post_author', $post_id);
    $categories = wp_get_post_categories($post_id, array('fields' => 'names'));
    $image = get_the_post_thumbnail_url($post_id, 'full');
    $modified = get_the_modified_time('c', $post_id);

    $article = array(
        '@context'         => 'https://schema.org',
        '@type'            => 'Article',
        'headline'         => get_the_title($post_id),
        'description'      => function_exists('dooroora_get_fast_excerpt') ? dooroora_get_fast_excerpt($post_id, 30) : get_the_excerpt($post_id),
        'datePublished'    => get_the_time('c', $post_id),
        'dateModified'     => $modified ?: get_the_time('c', $post_id),
        'author'           => array(
            '@type' => 'Person',
            'name'  => get_the_author_meta('display_name', $author_id),
            'url'   => get_author_posts_url($author_id),
        ),
        'publisher'        => array(
            '@type' => 'Organization',
            'name'  => get_bloginfo('name'),
        ),
        'mainEntityOfPage' => array(
            '@type' => 'WebPage',
            '@id'   => get_permalink($post_id),
        ),
        'wordCount'        => str_word_count(wp_strip_all_tags(get_post_field('post_content', $post_id))),
    );

    if ($image) $article['image'] = $image;
    if (!empty($categories)) $article['articleSection'] = implode(', ', $categories);

    return wp_json_encode($article, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
}

function dooroora_breadcrumb_schema() {
    $crumbs = dooroora_get_breadcrumbs_data();
    if (empty($crumbs)) return '';

    $items = array();
    $position = 1;
    foreach ($crumbs as $crumb) {
        $item = array(
            '@type'    => 'ListItem',
            'position' => $position,
            'name'     => $crumb['label'],
        );
        if (!empty($crumb['url'])) $item['item'] = $crumb['url'];
        $items[] = $item;
        $position++;
    }

    return wp_json_encode(array(
        '@context'        => 'https://schema.org',
        '@type'           => 'BreadcrumbList',
        'itemListElement' => $items,
    ), JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
}

function dooroora_author_schema() {
    if (!is_singular('post')) return '';

    $author_id = get_post_field('post_author', get_the_ID());
    $avatar_url = get_avatar_url($author_id, array('size' => 300));

    $author = array(
        '@context' => 'https://schema.org',
        '@type'    => 'Person',
        'name'     => get_the_author_meta('display_name', $author_id),
        'url'      => get_author_posts_url($author_id),
        'image'    => $avatar_url,
        'description' => get_the_author_meta('description', $author_id),
    );

    $role = get_the_author_meta('dooroora_author_role', $author_id);
    if ($role) $author['jobTitle'] = $role;

    return wp_json_encode($author, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
}

function dooroora_faq_schema($faqs) {
    if (empty($faqs)) return '';

    $items = array();
    foreach ($faqs as $faq) {
        $items[] = array(
            '@type'          => 'Question',
            'name'           => $faq['question'],
            'acceptedAnswer' => array(
                '@type' => 'Answer',
                'text'  => $faq['answer'],
            ),
        );
    }

    return wp_json_encode(array(
        '@context'   => 'https://schema.org',
        '@type'      => 'FAQPage',
        'mainEntity' => $items,
    ), JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
}


function dooroora_contact_page_schema() {
    if (!is_page('contact-us') && !is_page('contact')) return '';

    $schema = array(
        '@context'        => 'https://schema.org',
        '@type'           => 'ContactPage',
        'name'            => 'Contact the DoorOora Editorial Team',
        'description'     => 'Official contact page for DoorOora, an independent DIY home improvement and door hardware blog. Reach out for tutorial suggestions, reader questions, editorial fact-checking, or product review requests.',
        'url'             => get_permalink(),
        'mainEntity'      => array(
            '@type'         => 'Organization',
            'name'          => get_bloginfo('name'),
            'url'           => home_url('/'),
            'contactPoint'  => array(
                array(
                    '@type'             => 'ContactPoint',
                    'contactType'       => 'Reader Questions & Editorial Feedback',
                    'email'             => 'contact@dooroora.com',
                    'availableLanguage' => array('English')
                ),
                array(
                    '@type'             => 'ContactPoint',
                    'contactType'       => 'Editorial & Fact-Checking',
                    'email'             => 'editorial@dooroora.com',
                    'availableLanguage' => array('English')
                ),
                array(
                    '@type'             => 'ContactPoint',
                    'contactType'       => 'Product Testing & Brand Partnerships',
                    'email'             => 'partnerships@dooroora.com',
                    'availableLanguage' => array('English')
                )
            )
        )
    );

    return wp_json_encode($schema, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
}
