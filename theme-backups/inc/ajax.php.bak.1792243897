<?php
/**
 * AJAX handlers
 *
 * @package DoorOora
 * @since 1.0.0
 */

defined('ABSPATH') || exit;

/* ----------------------------------------------------------
   Category guide tabs (front page)
   ---------------------------------------------------------- */
add_action('wp_ajax_dooroora_get_category_guides', 'dooroora_ajax_get_category_guides');
add_action('wp_ajax_nopriv_dooroora_get_category_guides', 'dooroora_ajax_get_category_guides');
function dooroora_ajax_get_category_guides() {
    $category_slug = isset($_POST['category']) ? sanitize_text_field($_POST['category']) : '';

    $args = array(
        'posts_per_page' => 6,
        'post_status'    => 'publish',
    );

    if (!empty($category_slug) && 'all' !== $category_slug) {
        $args['category_name'] = $category_slug;
    }

    $query = new WP_Query($args);

    if (!$query->have_posts()) {
        wp_send_json_error(array(
            'message' => __('No guides found.', 'dooroora'),
            'html'    => '<p class="blog-no-results">' . esc_html__('No guides found.', 'dooroora') . '</p>',
        ));
    }

    ob_start();
    while ($query->have_posts()) {
        $query->the_post();
        ?>
        <article id="post-<?php the_ID(); ?>" <?php post_class('guide-card'); ?>>
            <?php if (has_post_thumbnail()) : ?>
                <a class="guide-card-thumb" href="<?php the_permalink(); ?>">
                    <?php the_post_thumbnail('blog-grid'); ?>
                </a>
            <?php endif; ?>
            <div class="guide-card-body">
                <?php if (has_category()) : ?>
                    <div class="guide-card-category"><?php the_category(', '); ?></div>
                <?php endif; ?>
                <h3 class="guide-card-title">
                    <a href="<?php the_permalink(); ?>"><?php the_title(); ?></a>
                </h3>
                <div class="guide-card-meta">
                    <span class="guide-card-author"><?php echo esc_html(get_the_author()); ?></span>
                    <span class="guide-card-date"><?php echo esc_html(get_the_date()); ?></span>
                    <span class="guide-card-readtime"><?php echo esc_html(dooroora_reading_time()); ?></span>
                </div>
                <div class="guide-card-excerpt"><?php echo esc_html(dooroora_excerpt(30)); ?></div>
                <a class="guide-card-cta" href="<?php the_permalink(); ?>"><?php esc_html_e('Read Guide', 'dooroora'); ?> &rarr;</a>
            </div>
        </article>
        <?php
    }
    wp_reset_postdata();
    $html = ob_get_clean();

    wp_send_json_success(array('html' => $html));
}

/* ----------------------------------------------------------
   Blog archive AJAX filtering
   ---------------------------------------------------------- */
add_action('wp_ajax_dooroora_filter_blog', 'dooroora_ajax_filter_blog');
add_action('wp_ajax_nopriv_dooroora_filter_blog', 'dooroora_ajax_filter_blog');
function dooroora_ajax_filter_blog() {
    $category = isset($_POST['category']) ? sanitize_text_field($_POST['category']) : 'all';
    $sort     = isset($_POST['sort']) ? sanitize_text_field($_POST['sort']) : 'latest';

    $args = array(
        'post_status'    => 'publish',
        'posts_per_page' => get_option('posts_per_page', 12),
    );

    if (!empty($category) && 'all' !== $category) {
        $args['category_name'] = $category;
    }

    switch ($sort) {
        case 'updated':
            $args['orderby'] = 'modified';
            $args['order']   = 'DESC';
            break;
        case 'popular':
            $args['orderby'] = 'comment_count';
            $args['order']   = 'DESC';
            break;
        case 'title':
            $args['orderby'] = 'title';
            $args['order']   = 'ASC';
            break;
        default:
            $args['orderby'] = 'date';
            $args['order']   = 'DESC';
            break;
    }

    $query = new WP_Query($args);

    if (!$query->have_posts()) {
        wp_send_json_error(array(
            'message' => __('No guides found.', 'dooroora'),
            'html'    => '<p class="blog-no-results">' . esc_html__('No guides found.', 'dooroora') . '</p>',
        ));
    }

    ob_start();
    while ($query->have_posts()) {
        $query->the_post();
        get_template_part('template-parts/cards/blog-card');
    }
    wp_reset_postdata();
    $html = ob_get_clean();

    wp_send_json_success(array('html' => $html));
}

/* ----------------------------------------------------------
   AJAX live search
   ---------------------------------------------------------- */
add_action('wp_ajax_dooroora_live_search', 'dooroora_ajax_live_search');
add_action('wp_ajax_nopriv_dooroora_live_search', 'dooroora_ajax_live_search');
function dooroora_ajax_live_search() {
    $query = isset($_POST['query']) ? sanitize_text_field($_POST['query']) : '';

    if (strlen($query) < 2) {
        wp_send_json_error(array('message' => '')); 
    }

    $posts = get_posts(array(
        's'              => $query,
        'posts_per_page' => 6,
        'post_status'    => 'publish',
        'post_type'      => array('post', 'page'),
    ));

    if (empty($posts)) {
        wp_send_json_success(array('html' => '<li class="live-search-no-results">' . esc_html__('No results found.', 'dooroora') . '</li>'));
    }

    ob_start();
    foreach ($posts as $post) {
        setup_postdata($post);
        ?>
        <li class="live-search-item">
            <a href="<?php the_permalink(); ?>">
                <?php if (has_post_thumbnail($post->ID)) : ?>
                    <span class="live-search-thumb"><?php echo get_the_post_thumbnail($post->ID, 'thumbnail'); ?></span>
                <?php endif; ?>
                <span class="live-search-info">
                    <span class="live-search-title"><?php echo esc_html(get_the_title($post->ID)); ?></span>
                    <span class="live-search-type"><?php echo get_post_type($post->ID) === 'post' ? esc_html__('Guide', 'dooroora') : esc_html__('Page', 'dooroora'); ?></span>
                </span>
            </a>
        </li>
        <?php
    }
    wp_reset_postdata();
    $html = ob_get_clean();

    wp_send_json_success(array('html' => $html));
}

/* ----------------------------------------------------------
   Newsletter subscription
   ---------------------------------------------------------- */
add_action('wp_ajax_dooroora_newsletter_subscribe', 'dooroora_ajax_newsletter_subscribe');
add_action('wp_ajax_nopriv_dooroora_newsletter_subscribe', 'dooroora_ajax_newsletter_subscribe');
function dooroora_ajax_newsletter_subscribe() {
    check_ajax_referer('dooroora_nonce', 'nonce');

    $email = isset($_POST['email']) ? sanitize_email($_POST['email']) : '';

    if (!is_email($email)) {
        wp_send_json_error(array('message' => __('Please enter a valid email address.', 'dooroora')));
    }

    global $wpdb;
    $table_name = $wpdb->prefix . 'dooroora_newsletter';

    $exists = $wpdb->get_var($wpdb->prepare(
        "SELECT id FROM $table_name WHERE email = %s", $email
    ));

    if ($exists) {
        wp_send_json_error(array('message' => __('You are already subscribed.', 'dooroora')));
    }

    $inserted = $wpdb->insert(
        $table_name,
        array(
            'email'      => $email,
            'status'     => 'active',
            'created_at' => current_time('mysql'),
        ),
        array('%s', '%s', '%s')
    );

    if ($inserted === false) {
        wp_send_json_error(array('message' => __('Subscription failed. Please try again.', 'dooroora')));
    }

    wp_send_json_success(array('message' => __('Thank you! You have been subscribed.', 'dooroora')));
}


/* ----------------------------------------------------------
   Contact form submission
   ---------------------------------------------------------- */
add_action('wp_ajax_dooroora_contact_form', 'dooroora_ajax_contact_form');
add_action('wp_ajax_nopriv_dooroora_contact_form', 'dooroora_ajax_contact_form');
function dooroora_ajax_contact_form() {
    check_ajax_referer('dooroora_nonce', 'nonce');

    // Honeypot check for bots
    if (!empty($_POST['dooroora_website_url'])) {
        wp_send_json_error(array('message' => __('Bot detected. Submission blocked.', 'dooroora')));
    }

    $name         = isset($_POST['name']) ? sanitize_text_field(wp_unslash($_POST['name'])) : '';
    $email        = isset($_POST['email']) ? sanitize_email(wp_unslash($_POST['email'])) : '';
    $inquiry_type = isset($_POST['inquiry_type']) ? sanitize_text_field(wp_unslash($_POST['inquiry_type'])) : 'general';
    $subject      = isset($_POST['subject']) ? sanitize_text_field(wp_unslash($_POST['subject'])) : '';
    $message      = isset($_POST['message']) ? sanitize_textarea_field(wp_unslash($_POST['message'])) : '';

    if (empty($name) || strlen($name) < 2) {
        wp_send_json_error(array('message' => __('Please provide your full name.', 'dooroora')));
    }

    if (!is_email($email)) {
        wp_send_json_error(array('message' => __('Please enter a valid email address.', 'dooroora')));
    }

    if (empty($subject)) {
        $subject = sprintf(__('New %s inquiry from %s', 'dooroora'), ucfirst($inquiry_type), $name);
    }

    if (empty($message) || strlen($message) < 10) {
        wp_send_json_error(array('message' => __('Please enter a detailed message (minimum 10 characters).', 'dooroora')));
    }

    $ip_address = isset($_SERVER['REMOTE_ADDR']) ? sanitize_text_field($_SERVER['REMOTE_ADDR']) : '';

    // Rate limiting: max 5 submissions per IP in 10 minutes
    $rate_key = 'dooroora_contact_limit_' . md5($ip_address);
    $sub_count = (int) get_transient($rate_key);
    if ($sub_count >= 5) {
        wp_send_json_error(array('message' => __('Too many requests. Please wait a few minutes before sending another message.', 'dooroora')));
    }
    set_transient($rate_key, $sub_count + 1, 600);

    // Save to database
    global $wpdb;
    $table_name = $wpdb->prefix . 'dooroora_contact_messages';
    $wpdb->insert(
        $table_name,
        array(
            'name'         => $name,
            'email'        => $email,
            'inquiry_type' => $inquiry_type,
            'subject'      => $subject,
            'message'      => $message,
            'ip_address'   => $ip_address,
            'status'       => 'unread',
            'created_at'   => current_time('mysql'),
        ),
        array('%s', '%s', '%s', '%s', '%s', '%s', '%s', '%s')
    );

    // Send email notification to admin
    $admin_email = get_option('admin_email');
    if ($admin_email) {
        $email_subject = sprintf('[DoorOora Contact] %s - %s', ucfirst($inquiry_type), $subject);
        $email_body    = "You have received a new contact inquiry via DoorOora:\n\n";
        $email_body   .= "Name: " . $name . "\n";
        $email_body   .= "Email: " . $email . "\n";
        $email_body   .= "Inquiry Type: " . ucfirst($inquiry_type) . "\n";
        $email_body   .= "Subject: " . $subject . "\n\n";
        $email_body   .= "Message:\n" . $message . "\n\n";
        $email_body   .= "---\nSent from DoorOora Contact Page (" . home_url('/contact-us') . ")";
        $headers       = array(
            'Content-Type: text/plain; charset=UTF-8',
            'Reply-To: ' . $name . ' <' . $email . '>',
        );
        @wp_mail($admin_email, $email_subject, $email_body, $headers);
    }

    wp_send_json_success(array(
        'message' => __('Thank you for contacting DoorOora! Your message has been received. Our team will review your inquiry and respond within 24 to 48 business hours.', 'dooroora')
    ));
}
